diff --git a/packages/coding-agent/test/interactive-mode-custom-program-status.test.ts b/packages/coding-agent/test/interactive-mode-custom-program-status.test.ts
new file mode 100644
index 0000000..75ee991
--- /dev/null
+++ b/packages/coding-agent/test/interactive-mode-custom-program-status.test.ts
@@ -0,0 +1,125 @@
+import { Container, type ProgramStatus, type Terminal, Text } from "@earendil-works/pi-tui";
+import { beforeAll, describe, expect, it, vi } from "vitest";
+import type { ExtensionUIContext } from "../src/core/extensions/types.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { ProgramStatusReporter } from "../src/modes/interactive/program-status-reporter.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+
+function setup() {
+	const reports: ProgramStatus[] = [];
+	const reporter = new ProgramStatusReporter(
+		() => ({ setProgramStatus: (status: ProgramStatus) => reports.push(status) }) as unknown as Terminal,
+		() => "Session",
+	);
+	reporter.handleEvent({ type: "agent_start" });
+	const hide = vi.fn();
+	const context = new Proxy({
+		extensionDialogs: [],
+		editorContainer: new Container(),
+		editor: Object.assign(new Text("editor"), { getText: () => "", setText: vi.fn() }),
+		ui: { setFocus: vi.fn(), requestRender: vi.fn(), showOverlay: vi.fn(() => ({ hide })) },
+		programStatus: reporter,
+		disposeActiveSelector: vi.fn(),
+	}, {
+		get(target, key, receiver) {
+			if (key in target) return Reflect.get(target, key, receiver);
+			const value = Reflect.get(InteractiveMode.prototype, key);
+			return typeof value === "function" ? value.bind(receiver) : value;
+		},
+	});
+	const custom = Reflect.get(context, "showExtensionCustom") as ExtensionUIContext["custom"];
+	const open = (options?: Parameters<ExtensionUIContext["custom"]>[1]) => {
+		let done!: (result: string | null) => void;
+		const promise = custom<string | null>((_tui, _theme, _kb, finish) => {
+			done = finish;
+			return new Text("Question");
+		}, options);
+		return { promise, done: (result: string | null) => done(result) };
+	};
+	return { reporter, reports, custom, open, hide, last: () => reports.at(-1) };
+}
+
+const blocked = { kind: "question" as const, message: "Choose a target" };
+const working = { state: "working", app: "pi", message: "Session" };
+
+describe("custom UI program status", () => {
+	beforeAll(() => initTheme("dark"));
+
+	it.each([false, true])("does not block by default (overlay=%s)", async (overlay) => {
+		const { open, reports, last } = setup();
+		const dialog = open({ overlay });
+		await Promise.resolve();
+		expect(last()).toEqual(working);
+		dialog.done("done");
+		await dialog.promise;
+		expect(reports).toEqual([working]);
+	});
+
+	it.each([
+		{ overlay: false, answer: "target" },
+		{ overlay: false, answer: null },
+		{ overlay: true, answer: "target" },
+		{ overlay: true, answer: null },
+	])("restores working after $answer (overlay=$overlay)", async ({ overlay, answer }) => {
+		const { open, last } = setup();
+		const dialog = open({ overlay, blocked });
+		await Promise.resolve();
+		expect(last()).toEqual({ state: "blocked", app: "pi", ...blocked });
+		dialog.done(answer);
+		await expect(dialog.promise).resolves.toBe(answer);
+		expect(last()).toEqual(working);
+	});
+
+	it.each([false, true])("restores the remaining question when another closes (overlay=%s)", async (overlay) => {
+		const { open, last } = setup();
+		const first = open({ overlay, blocked });
+		const second = open({ overlay, blocked: { ...blocked, message: "Second question" } });
+		await Promise.resolve();
+		expect(last()?.message).toBe("Second question");
+		first.done(null);
+		await first.promise;
+		expect(last()?.message).toBe("Second question");
+		second.done("target");
+		await second.promise;
+		expect(last()).toEqual(working);
+	});
+
+	it("restores done if the agent settles while the question is open", async () => {
+		const { open, reporter, last } = setup();
+		const dialog = open({ blocked });
+		await Promise.resolve();
+		reporter.handleEvent({ type: "agent_settled", aborted: false });
+		expect(last()?.state).toBe("blocked");
+		dialog.done(null);
+		await dialog.promise;
+		expect(last()).toEqual({ state: "done", app: "pi", message: "Session" });
+	});
+
+	it.each([false, true])("does not block if the factory finishes synchronously (overlay=%s)", async (overlay) => {
+		const { custom, reports } = setup();
+		await custom((_tui, _theme, _kb, done) => {
+			done(null);
+			return new Text("already cancelled");
+		}, { overlay, blocked });
+		expect(reports).toEqual([working]);
+	});
+
+	it.each([false, true])("does not block if the factory rejects (overlay=%s)", async (overlay) => {
+		const { custom, reports } = setup();
+		await expect(custom(async () => {
+			throw new Error("factory failed");
+		}, { overlay, blocked })).rejects.toThrow("factory failed");
+		expect(reports).toEqual([working]);
+	});
+
+	it("clears an overlay status if onHandle throws", async () => {
+		const { custom, last, hide } = setup();
+		await expect(custom(() => new Text("Question"), {
+			overlay: true,
+			blocked,
+			onHandle: () => { throw new Error("onHandle failed"); },
+		})).rejects.toThrow("onHandle failed");
+		expect(hide).toHaveBeenCalledOnce();
+		expect(last()).toEqual(working);
+	});
+});
